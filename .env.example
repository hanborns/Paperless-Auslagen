# Nach .env kopieren und ausfüllen (oder in Portainer als Stack-Env-Variablen setzen)

# Paperless API-Token: Paperless-Web-UI -> Profilsymbol -> "API-Token"
PAPERLESS_TOKEN=hier_dein_paperless_token

# Azure Document Intelligence Key (Default-Provider): Azure Portal ->
# Document Intelligence -> Keys and Endpoint
AZURE_DI_KEY=hier_dein_azure_key

# Nur nötig bei PROVIDER=anthropic – https://console.anthropic.com -> API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# Nur nötig, wenn ein selbst gehosteter ntfy-Server Auth verlangt
# NTFY_TOKEN=hier_dein_ntfy_token
